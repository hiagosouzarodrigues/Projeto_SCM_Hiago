Algoritmo "operadores"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Antonio Carlos Nicolodi 
// Descrição   : fazendo programa com operadores! (operções)
// Autor(a)    : Hiago
// Data atual  : 12/08/2026
   Var
// Seção de Declarações das variáveis
    num1 : inteiro
    num2 : inteiro
    bol1 : logico
    bol2 : logico
    tex1 : caractere
    tex2 : caractere
    resultado : caractere
    dados : real
   Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
    num1 <- 10
    num2 <- 5
    bol1 <- verdadeiro
    bol2 <- falso
    tex1 <- "Hiago "
    tex2 <- "Ana Julia"
    escreval (tex1 + tex2)
    escreval (" Digite um valor para a variável DADOS")
    leia (dados)
Fimalgoritmo